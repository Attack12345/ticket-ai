# ============================================================
# ticket-ai 环境变量模板（入库文件，不含任何真实密钥）
# 使用：cp .env.example .env 后按本机环境填写。
# 注意：.env 已被 .gitignore 排除；本 .env.example 仅作命名与说明用途。
# 生产环境用系统环境变量/密管注入，与 .env 同名单变量。
# ============================================================

# ---- MySQL（必填，无默认值则应用启动失败）----
MYSQL_URL=jdbc:mysql://<host>:<port>/ticket_ai?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USERNAME=<user>
MYSQL_PASSWORD=<password>

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---- RocketMQ ----
ROCKETMQ_NAMESRV=127.0.0.1:9876

# ---- Elasticsearch ----
ES_URIS=http://127.0.0.1:9200

# ---- JWT（生产必须为 ≥32 字符随机值；否则 JwtTokenProvider 拒绝启动）----
# 生成示例：openssl rand -base64 48
JWT_SECRET=change-me-<at-least-32-characters>-random-secret
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ---- LLM（留空时 AI 功能自动降级；key 为敏感信息勿入库）----
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBED_MODEL=text-embedding-3-small
LLM_TIMEOUT_MS=15000